# Workspace image: Flask UI, the HTTP API, and the two queue workers.
# No torch, no CUDA, no weights — python:3.10-slim, not the CUDA image.
# The pipeline stays in qwen-inference (Dockerfile). The orchestrator calls it
# over SSE: POST /v1/generate -> progress / done | error.
#
# Same uv.lock as the inference image, without the ml group. compose.yaml runs
# this image three times: gunicorn, `python -m qimg.processor`, and
# `python -m qimg.orchestrator`. The image HEALTHCHECK curls :8000, so the
# workers disable it in compose.

# ─────────────────────────────── base ───────────────────────────────
FROM docker.io/library/python:3.10-slim AS base

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PYTHON_PREFERENCE=only-system \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv/app

ENV VIRTUAL_ENV=/srv/app/.venv \
    PATH="/srv/app/.venv/bin:${PATH}"

# Web runtime only (Flask, gunicorn, Pillow, Mongo, MinIO, Rabbit, cryptography).
# No ml group, no dev group.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

# ──────────────────────────────── app ───────────────────────────────
FROM base AS app

# Generated images live on a volume so a recreate does not lose them.
RUN useradd --create-home --uid 1000 service \
    && mkdir -p /data/outputs \
    && chown -R service:service /data

COPY --chown=service:service app ./app
COPY --chown=service:service qimg ./qimg
COPY --chown=service:service wsgi.py ./
USER service

ENV OUTPUT_DIR=/data/outputs \
    PORT=8000

EXPOSE 8000
# Podman's default OCI format drops HEALTHCHECK ("not supported ... ignored"); build with
# --format docker if you want the image to carry it. Every deployment here probes
# GET /healthz over HTTP instead: the Switch-Service catalog and the README curl commands.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fsS http://localhost:8000/healthz || exit 1

# One gunicorn worker. Threads stay high because the browser polls task status
# while another request is still reading a body. timeout 0: a request may wait
# on a slow upstream. The queue workers replace this command in compose.yaml.
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "1", "--threads", "8", "--timeout", "0", "--graceful-timeout", "60", "--access-logfile", "-", "wsgi:app"]
