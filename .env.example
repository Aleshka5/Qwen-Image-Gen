# Один .env на два контейнера. Секции подписаны: кто читает — тот и берёт.
#   [qwen-inference] — Dockerfile, torch 2.7.1+cu126, GPU, пайплайн
#   [qwen-image]     — Dockerfile.web, Flask, UI/API/WebStorage, клиент инференса
# Общие ключи (MODEL_ID, PRELOAD_MODEL, LOG_LEVEL) читают оба: первый — чтобы
# загрузить модель, второй — чтобы показать её имя в заголовке.

# ═══════════════════════ [qwen-inference] модель ═══════════════════════
MODEL_ID=Qwen/Qwen-Image-2.1
# Закрепить конкретную ревизию репозитория HF (необязательно)
# MODEL_REVISION=main
# auto — diffusers сам подберёт класс по model_index.json.
# Можно указать явно, например QwenImageEditPlusPipeline или QwenImagePipeline.
PIPELINE_CLASS=auto
# Токен нужен только для приватных/gated репозиториев
# HF_TOKEN=
HF_HOME=/data/huggingface
HF_XET_HIGH_PERFORMANCE=1

# ═══════════════ [qwen-inference] память и точность (V100) ═══════════════
# int8    — weight-only int8 DiT (~7 GB вместо ~14 GB). Запас VRAM под KV-кэш референсов
# fp16    — DiT и VAE в fp16 (~16 GB весов на GPU). Хватает для text-to-image и 1–2 фото
# offload — accelerate тасует блоки RAM<->VRAM: влезет всегда, но медленно
MEMORY_MODE=int8
DEVICE=cuda
# Qwen3-VL 8B целиком в VRAM вместе с DiT не влезает (~33 GB). Остаток — в RAM.
TEXT_ENCODER_DEVICE=cpu
# float16: вдвое меньше RAM, чем float32. На старом CPU-бэкенде PyTorch вернитесь к float32.
TEXT_ENCODER_DTYPE=float16
# Часть Qwen3-VL в VRAM (fp16): vision-башня (~1.1 GB, через неё идут референсы)
# и первые N из 36 слоёв декодера (~0.4 GB за слой). 24 покрывает DeepStack (8/16/24).
TEXT_ENCODER_GPU_VISION=true
TEXT_ENCODER_GPU_LAYERS=24
# native — PyTorch SDPA. FlashAttention-2 на V100 (SM 7.0) недоступен.
# Значение sdpa из старых конфигов принимается как алиас native.
ATTENTION_BACKEND=native
# Запасной путь. Пока кадр не больше 2752×1536, decode идёт целиком:
# DiT на это время уезжает в RAM. Тайлы включаются, только если полный кадр не влез.
VAE_TILING=true
# Сторона тайла в пикселях для запасного пути.
VAE_TILE_SIZE=1536
VAE_SLICING=true
# Грузить веса при старте, а не на первом запросе
PRELOAD_MODEL=true

# ═══════════════ [оба] параметры генерации ═══════════════
# Инференс применяет их к пайплайну, оркестратор — к форме и валидации.
DEFAULT_STEPS=40
MAX_STEPS=60
# 1.0 — штатный режим 2.1, без второго прохода и второго KV-кэша
DEFAULT_TRUE_CFG_SCALE=1.0
DEFAULT_NEGATIVE_PROMPT=
MIN_SIDE=512
MAX_SIDE=2752

# ═══════════════ [оба] входные фото ═══════════════
MAX_IMAGES=10
MAX_UPLOAD_MB=60
INPUT_MAX_SIDE=1536

# ═══════════════════════ [qwen-image] инференс ═══════════════════════
# Имя сервиса в qwen_image_gen_network. Порт 8010 — внутренний, на хост не публикуется.
INFERENCE_URL=http://qwen-inference:8010
# Предел на весь поток одной генерации, секунды. Внутри него инференс шлёт
# keepalive каждые 15 с, так что это и есть потолок времени на job.
INFERENCE_TIMEOUT=1800
# Проба /healthz инференса: её зовёт и страница, и control plane.
INFERENCE_HEALTH_TIMEOUT=3

# ═══════════════════════ [qwen-image] сервис ═══════════════════════
# Адрес внутри контейнера. Порт на хост не публикуется: снаружи сервис
# доступен только Auth Gateway как http://qwen-image:8000 в сети qwen_image_gen_network.
# gunicorn в образе слушает 0.0.0.0:8000 независимо от HOST/PORT (они для `python wsgi.py`).
HOST=0.0.0.0
PORT=8000
OUTPUT_DIR=/data/outputs
KEEP_OUTPUTS=200
LOG_LEVEL=INFO
# Сохранение удачной генерации. WebStorage в сети auth_network, DNS-имя `app`.
WEBSTORAGE_URL=http://app:8000
# Таймаут клиента на POST /api/generated, секунды. Не путать с INFERENCE_TIMEOUT.
WEBSTORAGE_TIMEOUT=60
