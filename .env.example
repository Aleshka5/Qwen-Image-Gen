# One env file for the three processes in this repository: qwen-image,
# qimg-processor, and qimg-orchestrator. The model container reads a different
# file, in Common/models/services/inference. Keys below that the model used to
# share are ignored by this image; they stay so an older copy still parses.
#
# Leave MONGO_URL, RABBIT_URL, and MINIO_ENDPOINT empty together to run the UI
# on the in-memory store (tests and a local page). Setting only some of them
# makes the process refuse to start.

# ═══════════════════════ model (read by qwen-inference, not here) ═══════════════════════
MODEL_ID=Qwen/Qwen-Image-2.1
# MODEL_REVISION=main
PIPELINE_CLASS=auto
# HF_TOKEN=
HF_HOME=/data/huggingface
HF_XET_HIGH_PERFORMANCE=1

# ═══════════════════════ memory and precision (qwen-inference, V100) ═══════════════════════
MEMORY_MODE=int8
DEVICE=cuda
TEXT_ENCODER_DEVICE=cpu
TEXT_ENCODER_DTYPE=float16
TEXT_ENCODER_GPU_VISION=true
TEXT_ENCODER_GPU_LAYERS=24
ATTENTION_BACKEND=native
VAE_TILING=true
VAE_TILE_SIZE=1536
VAE_SLICING=true
PRELOAD_MODEL=true

# ═══════════════════════ generation limits (this service) ═══════════════════════
DEFAULT_STEPS=40
MAX_STEPS=60
DEFAULT_TRUE_CFG_SCALE=1.0
DEFAULT_NEGATIVE_PROMPT=
MIN_SIDE=512
MAX_SIDE=2752

# ═══════════════════════ uploads ═══════════════════════
MAX_IMAGES=10
# Operator cap on one request body. The editor does not downscale the project photo.
MAX_UPLOAD_MB=512
INPUT_MAX_SIDE=1536
# Rectangles and circles on one level.
MAX_SHAPES=20
# Copies on one generation form. Above 1, every seed is random.
MAX_COPIES=8

# ═══════════════════════ inference client ═══════════════════════
# Name on models_network. Port 8010 is not published by this repository.
INFERENCE_URL=http://qwen-inference:8010
INFERENCE_TIMEOUT=1800
INFERENCE_HEALTH_TIMEOUT=3

# ═══════════════════════ web process ═══════════════════════
HOST=0.0.0.0
PORT=8000
OUTPUT_DIR=/data/outputs
KEEP_OUTPUTS=200
LOG_LEVEL=INFO

# ═══════════════════════ Mongo, RabbitMQ, MinIO (common_network) ═══════════════════════
# The three processes must join common_network or these names do not resolve.
# Do not point anything at hostname redis: on the auth network that name is rejected_cache.
# Credentials come from Common/.env.common. Do not commit the real file.
# Mongo database qimg is the source of truth. This service does not use Postgres.
MONGO_URL=mongodb://mongo:27017/qimg
MONGO_DB=qimg
# The process declares exchange qimg and queues qimg.intake / qimg.gen. A dedicated
# vhost is not required. The user needs permission to declare those names.
RABBIT_URL=amqp://qimg:change-me@rabbit:5672/
# One bucket. IAM user qimg, policy qimg-images, not the minioadmin root.
# An IAM access key may be longer than 20 characters; a service-account key may not.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=qimg
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=qimg-images
MINIO_SECURE=false
# Fernet key material for provider secrets. Empty refuses to store an external API key.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SETTINGS_SECRET=change-me-long-random

# WebStorage is no longer the archive for this flow. The key is unused.
WEBSTORAGE_URL=http://app:8000
WEBSTORAGE_TIMEOUT=60
