# ─────────────────────────── Модель ───────────────────────────
# Только для отображения: /healthz и заголовок в UI. Никаких весов здесь нет и
# torch не импортируется — пайплайн живёт в трёх inference-сервисах из
# ../Common/models, их контракт описан в docs/models_inference_api.md.
MODEL_ID=Qwen/Qwen-Image-2.1

# ───────────── Inference-сервисы (внутри models_network) ─────────────
# Имена — это имена контейнеров в models_network. Порты внутренние, наружу не публикуются.
EMBEDDING_URL=http://qwen-embed:8011
VAE_URL=http://qwen-vae:8012
DIT_URL=http://qwen-dit:8013
# Площадь, к которой приводится каждый референс (output_resolution пайплайна 2.1).
OUTPUT_RESOLUTION=1024
# Секунды. Первый запрос после рестарта ждёт загрузки весов стадии (у энкодера ~17 GB),
# стрим DiT живёт весь цикл денойза.
ENCODER_TIMEOUT=600
VAE_TIMEOUT=600
DIT_TIMEOUT=3600
HEALTH_TIMEOUT=3
# Проверять /healthz стадий при старте (веса при этом не грузятся — они у стадий).
PRELOAD_MODEL=true

# ─────────────────────── Параметры генерации ───────────────────────
DEFAULT_STEPS=40
MAX_STEPS=60
# 1.0 — штатный режим 2.1, без второго прохода и второго KV-кэша
DEFAULT_TRUE_CFG_SCALE=1.0
DEFAULT_NEGATIVE_PROMPT=
MIN_SIDE=512
MAX_SIDE=2752

# ───────────────────────── Входные фото ─────────────────────────
MAX_IMAGES=10
MAX_UPLOAD_MB=60
INPUT_MAX_SIDE=1536

# ──────────────────────────── Сервис ────────────────────────────
# gunicorn в образе слушает 0.0.0.0:8000 независимо от HOST/PORT (они для `python wsgi.py`).
HOST=0.0.0.0
PORT=8000
OUTPUT_DIR=/data/outputs
KEEP_OUTPUTS=200
LOG_LEVEL=INFO
# Сохранение удачной генерации. WebStorage в сети auth_network, DNS-имя `app`.
WEBSTORAGE_URL=http://app:8000
# Таймаут клиента на POST /api/generated, секунды.
WEBSTORAGE_TIMEOUT=60
