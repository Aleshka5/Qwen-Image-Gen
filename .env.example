# ─────────────────────────── Модель ───────────────────────────
MODEL_ID=Qwen/Qwen-Image-2.1
# Закрепить конкретную ревизию репозитория HF (необязательно)
# MODEL_REVISION=main
# auto — diffusers сам подберёт класс по model_index.json.
# Можно указать явно, например QwenImageEditPlusPipeline или QwenImagePipeline.
PIPELINE_CLASS=auto
# Токен нужен только для приватных/gated репозиториев
# HF_TOKEN=
HF_HOME=/data/huggingface
HF_XET_HIGH_PERFORMANCE=1

# ────────────────── Память и точность (Tesla V100) ──────────────────
# int8    — веса DiT квантуются optimum-quanto, вычисления в fp16 (по умолчанию)
# fp16    — без квантизации; для 20B-модели в 32 GB VRAM почти наверняка OOM
# offload — accelerate тасует блоки RAM<->VRAM: влезет всегда, но медленно
MEMORY_MODE=int8
DEVICE=cuda
# Текстовый энкодер живёт в CPU RAM (требование стенда), fp32 ради стабильности
TEXT_ENCODER_DEVICE=cpu
TEXT_ENCODER_DTYPE=float32
# V100 (SM 7.0) не поддерживает FlashAttention-2 — оставляем SDPA
ATTENTION_BACKEND=sdpa
VAE_TILING=true
VAE_SLICING=true
# Грузить веса при старте, а не на первом запросе
PRELOAD_MODEL=true

# ─────────────────────── Параметры генерации ───────────────────────
DEFAULT_STEPS=30
MAX_STEPS=60
DEFAULT_TRUE_CFG_SCALE=4.0
DEFAULT_NEGATIVE_PROMPT=" "
MIN_SIDE=512
MAX_SIDE=1664

# ───────────────────────── Входные фото ─────────────────────────
MAX_IMAGES=10
MAX_UPLOAD_MB=60
INPUT_MAX_SIDE=1536

# ──────────────────────────── Сервис ────────────────────────────
HOST=0.0.0.0
PORT=8000
OUTPUT_DIR=/data/outputs
KEEP_OUTPUTS=200
REQUEST_TIMEOUT=1800
LOG_LEVEL=INFO
