# Rootless Quadlet. Both networks are attached on every start, including boot
# (user lingering). deploy_auth_network is the Auth stack network where
# WebStorage is DNS name "app". Do not publish port 8000.
#
# Install:
#   mkdir -p ~/.config/containers/systemd
#   cp deploy/qwen-image.container ~/.config/containers/systemd/
#   systemctl --user daemon-reload
# WantedBy=default.target wires it in. systemctl enable is not used:
# the generated unit is transient.
#
# `podman generate systemd --new` is not used: it replays the original
# `podman run`, which had only qwen_image_gen_network.

[Container]
Image=qwen-image-service:latest
ContainerName=qwen-image
Network=qwen_image_gen_network
Network=deploy_auth_network
EnvironmentFile=%h/projects/qwen-image-service/.env
Volume=qwen-hf-cache:/data/huggingface
Volume=qwen-outputs:/data/outputs
ShmSize=8g
Memory=64g
SecurityLabelDisable=true
AddDevice=nvidia.com/gpu=all
PodmanArgs=--replace
Notify=false

[Service]
Restart=always

[Install]
WantedBy=default.target
